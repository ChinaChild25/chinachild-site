{
  "name": "chinachild-site",
  "version": "0.1.0",
  "private": true,
  "comment:browserslist": "Targets the support floor of the JS Baseline features PageSpeed flagged (Array.prototype.at/Object.hasOwn → Chrome 92 / Safari 15.4, 2022+). Stops Next/SWC shipping those polyfills + over-transpiling on every page (lighter JS, less main-thread parse/eval — the throttled-CPU bottleneck). Drops pre-2022 browsers (<1% of a 2026 RU audience); widen this list if analytics show meaningful old-browser traffic.",
  "browserslist": [
    "chrome >= 92",
    "edge >= 92",
    "firefox >= 91",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "samsung >= 16",
    "opera >= 78",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --env-file-if-exists=.env.local scripts/generate-public-content-snapshot.mjs && CHECK_ONLY=1 node scripts/generate-blog-audio.mjs && CHECK_ONLY=1 node scripts/generate-learning-audio.mjs",
    "build": "next build",
    "postbuild": "node scripts/audit-built-jsonld.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "audit:jsonld": "node scripts/audit-built-jsonld.mjs",
    "gen:images": "node --env-file=.env.local scripts/generate-blog-images.mjs",
    "gen:audio": "node --env-file=.env.local scripts/generate-blog-audio.mjs",
    "gen:learning-audio": "node --env-file=.env.local scripts/generate-learning-audio.mjs",
    "check:audio": "CHECK_ONLY=1 node scripts/generate-blog-audio.mjs && CHECK_ONLY=1 node scripts/generate-learning-audio.mjs",
    "gen:images:dry": "DRY_RUN=1 node --env-file=.env.local scripts/generate-blog-images.mjs",
    "gen:audio:dry": "DRY_RUN=1 node --env-file=.env.local scripts/generate-blog-audio.mjs",
    "publish:scheduled": "node scripts/publish-scheduled-blog.mjs",
    "publish:scheduled:2": "PUBLISH_COUNT=2 node scripts/publish-scheduled-blog.mjs",
    "audit:redirects": "node scripts/audit-redirects.mjs",
    "audit:production": "node scripts/audit-production-readiness.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.6",
    "@supabase/supabase-js": "^2.105.4",
    "@yandex/smart-captcha": "2.9.1",
    "clsx": "^2.1.1",
    "hanzi-writer": "^3.7.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.11.0",
    "marked": "^18.0.4",
    "next": "^15.5.15",
    "nodemailer": "^8.0.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "lighthouse": "^13.4.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "typescript": "^5"
  }
}
