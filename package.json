{
  "name": "chinachild-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gen:images": "node --env-file=.env.local scripts/generate-blog-images.mjs",
    "gen:audio": "node --env-file=.env.local scripts/generate-blog-audio.mjs",
    "gen:images:dry": "DRY_RUN=1 node --env-file=.env.local scripts/generate-blog-images.mjs",
    "gen:audio:dry": "DRY_RUN=1 node --env-file=.env.local scripts/generate-blog-audio.mjs",
    "publish:scheduled": "node scripts/publish-scheduled-blog.mjs",
    "publish:scheduled:2": "PUBLISH_COUNT=2 node scripts/publish-scheduled-blog.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.6",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/speed-insights": "^2.0.0",
    "@yandex/smart-captcha": "2.9.1",
    "clsx": "^2.1.1",
    "hanzi-writer": "^3.7.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.11.0",
    "marked": "^18.0.4",
    "next": "^15.5.15",
    "nodemailer": "^8.0.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "typescript": "^5"
  }
}
