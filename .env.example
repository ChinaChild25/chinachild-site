# ChinaChild environment inventory
#
# Production and Preview values live in Vercel. Local values live in
# `.env.local`, which is gitignored. Never put real secrets in this file.
# `NEXT_PUBLIC_*` values are bundled into browser code and are not secrets.

# =============================================================================
# 1. CORE APPLICATION — required for a complete production build
# =============================================================================

# Public marketing origin. Production: https://chinachild.ru
NEXT_PUBLIC_SITE_URL=https://chinachild.ru
# Separate authenticated learning platform.
NEXT_PUBLIC_APP_URL=https://my.chinachild.ru

# Public-content database. The anon key is browser-safe and constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: server-only writes for leads, rate limits, and media uploads.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# 2. OPENAI — required for diagnostics and media generation
# =============================================================================

# SECRET: server-only API key. Rotate immediately if it enters a tracked file.
OPENAI_API_KEY=
# Diagnostic model defaults; optional overrides.
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

# One-time content TTS generation. Visitors play the cached Supabase MP3.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_SPEED=0.9
OPENAI_TTS_INSTRUCTIONS="Speak in clear, natural Standard Mandarin Chinese with accurate tones. Use a warm professional teacher voice and a measured learning-friendly pace. Read only the supplied text."
SUPABASE_AUDIO_BUCKET=vocab-public-audio
SUPABASE_AUDIO_PREFIX=blog
# Optional generation parallelism (1–10).
AUDIO_GENERATION_CONCURRENCY=4

# =============================================================================
# 3. LEADS AND ABUSE PROTECTION — required for production lead delivery
# =============================================================================

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
# SECRET
SMTP_PASSWORD=
SMTP_SECURE=true
LEAD_EMAIL_FROM="ChinaChild <leads@notify.chinachild.ru>"
LEAD_EMAIL_TO=chinachild@yandex.ru
# Отдельный ящик/папка для откликов. Тема писем начинается с [КАНДИДАТ].
CAREER_EMAIL_TO=chinachild@yandex.ru
# SECRET: random value used to irreversibly hash visitor IP addresses.
IP_HASH_SALT=

# Optional Yandex SmartCaptcha. Leave both empty to disable locally.
NEXT_PUBLIC_YANDEX_SMARTCAPTCHA_SITE_KEY=
# SECRET
YANDEX_SMARTCAPTCHA_SERVER_KEY=

# =============================================================================
# 4. ANALYTICS AND SEARCH VERIFICATION — optional; usually blank locally
# =============================================================================

NEXT_PUBLIC_YM_ID=
# SECRET: Yandex Metrica Measurement Protocol token for server fallback delivery.
# The counter must have Measurement Protocol enabled separately by its owner.
YANDEX_METRIKA_MEASUREMENT_TOKEN=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_MAILRU_VERIFICATION=

# Local read-only SEO collector. Google uses Application Default Credentials
# from the local gcloud profile; never put Google credential JSON in this repo.
GOOGLE_SEARCH_CONSOLE_PROPERTY=
GA4_PROPERTY_ID=
# SECRET: local OAuth token with metrika:read and Webmaster read access only.
YANDEX_OAUTH_TOKEN=
# Optional when exactly one chinachild.ru resource can be discovered.
YANDEX_METRIKA_COUNTER_ID=
YANDEX_WEBMASTER_HOST_ID=

# IndexNow has a checked-in public key fallback. These are optional overrides.
INDEXNOW_KEY=
# SECRET: protects manual /api/indexnow triggers.
INDEXNOW_SECRET=
# Vercel supplies CRON_SECRET automatically when cron protection is configured.
CRON_SECRET=

# =============================================================================
# 5. OPTIONAL CONTENT-GENERATOR OVERRIDES
# =============================================================================

IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=high
