# ChinaChild public site — environment variables.
#
# All NEXT_PUBLIC_* values are bundled into the client. Anything secret must
# NOT be prefixed with NEXT_PUBLIC_ and must only be imported from server
# modules (lib/supabase/public-content.ts is server-only).

# ----- Supabase (public read of grammar/vocab content) -----
# Anon credentials only — RLS in chinachild-sandbox restricts anon reads to
# published grammar articles, system/imported HSK decks, and dictionary terms.
# Service role is server-only and required for durable lead storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Cross-site URLs -----
# Public marketing site (this repo).
NEXT_PUBLIC_SITE_URL=https://chinachild-site.vercel.app
# Authenticated learning platform (chinachild-sandbox).
NEXT_PUBLIC_APP_URL=https://app.chinachild.ru

# ----- Analytics -----
# Yandex.Metrika counter ID (https://metrika.yandex.ru)
NEXT_PUBLIC_YM_ID=
# Google Analytics 4 Measurement ID, формат G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# ----- SEO verification tokens (optional) -----
# Yandex.Webmaster verification meta tag value
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Google Search Console verification meta tag value (без префикса google-site-verification=)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_MAILRU_VERIFICATION=

# ----- IndexNow (optional) -----
INDEXNOW_KEY=

# ----- Lead delivery -----
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=info@chinachild.ru
SMTP_PASSWORD=
SMTP_SECURE=true
LEAD_EMAIL_FROM="ChinaChild <info@chinachild.ru>"
LEAD_EMAIL_TO=chinachild@yandex.ru
IP_HASH_SALT=

# ----- OpenAI API (для AI-диагностики /diagnostic) -----
# Серверный секрет, НЕ NEXT_PUBLIC_*. Используется только в /api/diagnose,
# /api/tutor и /api/speech-eval. Без него страница работает в графически-полном,
# но AI-урезанном режиме (fallback статичный разбор).
OPENAI_API_KEY=
# Модели — можно переопределять. По умолчанию:
#   diagnose / speech-eval → gpt-4o (точность важна)
#   tutor / micro-insights → gpt-4o-mini (экономия токенов)
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
